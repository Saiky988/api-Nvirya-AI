APP_NAME=Nvirya AI
APP_ENV=production
DEBUG=false

API_PREFIX=/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

DATABASE_URL=sqlite:///./storage/nvirya.db

XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=

CODE_MODEL=qwen/qwen3.8-max:free
CODE_FALLBACK_MODEL=mistralai/codestral-2508
ANALYSIS_MODEL=google/gemini-3.8-flash
FAST_MODEL=qwen/qwen3.7-flash:free

DAILY_TASK_LIMIT=30
RATE_LIMIT_PER_MINUTE=1

MAX_AGENT_STEPS=8
MAX_TOOL_CALLS_PER_TASK=8
MAX_SEARCH_CALLS=5
MAX_FETCH_CALLS=5
MAX_ARTIFACTS=5
MAX_TASK_SECONDS=120

SEARXNG_URL=

MAX_REQUEST_BODY_MB=10
MAX_ARTIFACT_MB=10
